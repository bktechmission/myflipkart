# Ask Sauby configuration. `make setup` copies this to .env and fills the secrets
# with random values. Never commit .env.

# --- secrets (generated by make setup) ---
SESSION_SECRET=
MOCK_IDP_CLIENT_SECRET=
# Optional: require a password on the MockID demo login. Empty = pick an account and go.
MOCK_IDP_PASSWORD=

# --- sign-in ---
# Real Google login: create an OAuth client (Web) with redirect http://localhost:8080/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated admin emails (demo admin by default)
ADMIN_EMAILS=aarav@example.com
# Give your own Google account a copy of the demo orders
DEMO_ORDERS_FOR=

# --- LLM gateway (any OpenAI-compatible API) ---
ROUTER=auto
INTERNAL_LLM_URL=http://localhost:11434/v1
INTERNAL_LLM_MODEL=qwen2.5:3b
EMBED_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EXTERNAL_LLM_URL=
EXTERNAL_LLM_MODEL=
EXTERNAL_LLM_API_KEY=

# --- guardrails & demo behaviour ---
AUTO_REFUND_LIMIT=29
MAX_AUTO_REFUNDS_PER_DAY=3
SIM_AGENTS=1
SIM_JOIN_AFTER_SEC=6
PUBLIC_DEMO=0
METRICS_TOKEN=
